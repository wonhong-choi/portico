<Window x:Class="PorticoRti1516e.Native.WpfReceiver.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Portico IEEE-1516e WPF Receiver" Height="560" Width="720">
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Controls + status -->
        <StackPanel Grid.Row="0" Orientation="Horizontal" Margin="0,0,0,10">
            <Button x:Name="StartButton" Content="Start" Width="90" Height="28" Click="StartButton_Click" />
            <Button x:Name="StopButton" Content="Stop" Width="90" Height="28" Margin="8,0,0,0" IsEnabled="False" Click="StopButton_Click" />
            <TextBlock Text="Status:" VerticalAlignment="Center" Margin="20,0,6,0" FontWeight="Bold" />
            <TextBlock x:Name="StatusText" Text="Idle" VerticalAlignment="Center" />
        </StackPanel>

        <!-- Latest ObjectRoot.A attribute values -->
        <GroupBox Grid.Row="1" Header="Latest ObjectRoot.A attributes" Padding="8" Margin="0,0,0,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Text="object" FontWeight="Bold" Margin="0,2,12,2" />
                <TextBlock Grid.Row="0" Grid.Column="1" x:Name="ObjectNameText" Text="-" Margin="0,2,0,2" />

                <TextBlock Grid.Row="1" Grid.Column="0" Text="aa" FontWeight="Bold" Margin="0,2,12,2" />
                <TextBlock Grid.Row="1" Grid.Column="1" x:Name="AaText" Text="-" Margin="0,2,0,2" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="ab" FontWeight="Bold" Margin="0,2,12,2" />
                <TextBlock Grid.Row="2" Grid.Column="1" x:Name="AbText" Text="-" Margin="0,2,0,2" />

                <TextBlock Grid.Row="3" Grid.Column="0" Text="ac" FontWeight="Bold" Margin="0,2,12,2" />
                <TextBlock Grid.Row="3" Grid.Column="1" x:Name="AcText" Text="-" Margin="0,2,0,2" />
            </Grid>
        </GroupBox>

        <TextBlock Grid.Row="2" Text="Event log (interactions + status)" FontWeight="Bold" Margin="0,0,0,4" />

        <!-- Scrolling event log -->
        <ListBox Grid.Row="3" x:Name="LogList" ItemsSource="{Binding Log}"
                 FontFamily="Consolas" FontSize="12"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto" />
    </Grid>
</Window>
