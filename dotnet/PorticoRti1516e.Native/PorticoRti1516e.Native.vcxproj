    <ClCompile Include="Types\Marshal.cpp" />
    <ClCompile Include="Exceptions\PorticoRtiException.cpp" />
    <ClCompile Include="FederateAmbassador\NativeFederateAmbassadorBridge.cpp" />
    <ClCompile Include="Ambassador\ManagedRTIambassador.cpp" />
    <ClCompile Include="Time\ManagedHLAfloat64Time.cpp" />
